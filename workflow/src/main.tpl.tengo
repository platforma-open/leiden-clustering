wf := import("@platforma-sdk/workflow-tengo:workflow")
assets:= import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")

pfLeidenConv := import(":pf-leiden-conv")
leidenClusteringTpl := assets.importTemplate(":leiden-clustering-calculation")

wf.prepare(func(args){
	return {
		resolvedInput: wf.resolve(args.principalComponentsRef, { errIfMissing: true })
	}
})

wf.body(func(args) {

	blockId := wf.blockId().getDataAsJson()
	embeddings := args.resolvedInput
	inputSpec := embeddings.spec

	resolution := args.resolution
	// nNeighbors := args.nNeighbors

	// Set default memory and CPU for the cluster/linker imports: those carry one
	// row per cell, orders of magnitude smaller than the embeddings matrix.
    defaultConvMem := "16GiB" // @TODO: set based on the size of the input
    defaultConvCpu := 1 // @TODO: set based on the size of the input

	// The embeddings export is the heaviest conversion in the block: the long-format
	// pcvalue p-column holds one row per (cell, principal component) pair, which reaches
	// tens of millions of rows on real datasets. Parquet keeps it columnar and streams
	// through sink_parquet, instead of paying CSV text encoding for two high-cardinality
	// string columns.
	embeddingsConvMem := "32GiB" // @TODO: set based on the size of the input
	embeddingsConvCpu := 4 // @TODO: set based on the size of the input

	embeddingsParquet := xsv.exportFrame([embeddings], "parquet", { mem: embeddingsConvMem, cpu: embeddingsConvCpu })

	leidenClusteringRender := render.create(leidenClusteringTpl, {
		embeddingsParquet: embeddingsParquet,
		resolution: resolution,
		mem: "32GiB",
		cpu: 1
	})

	leidenImportParams := pfLeidenConv.getColumns(blockId, inputSpec, resolution)
	leidenPf := xsv.importFile(leidenClusteringRender.output("leidenClustersParquet"), "parquet", leidenImportParams, {splitDataAndSpec: true, mem: defaultConvMem, cpu: defaultConvCpu})

	// Extract cluster column spec from leidenImportParams and convert to axis spec (change valueType key to type)
	clusterColumnSpec := leidenImportParams.columns[0].spec
	clusterAxisSpec := {
		name: clusterColumnSpec.name,
		type: clusterColumnSpec.valueType,
		domain: clusterColumnSpec.domain,
		annotations: clusterColumnSpec.annotations
	}

	// Create linker column: [SampleId][CellId][Cluster] -> 1
	leidenLinkerPf := xsv.importFile(leidenClusteringRender.output("leidenLinkerParquet"), "parquet", {
		axes: [{
			column: "SampleId",
			spec: inputSpec.axesSpec[0]
		}, {
			column: "CellId", 
			spec: inputSpec.axesSpec[1]
		}, {
			column: "Cluster",
			spec: clusterAxisSpec
		}],
		columns: [{
			column: "Link",
			spec: {
				name: "pl7.app/rna-seq/clusterLink",
				valueType: "Int",
				annotations: {
					"pl7.app/isLinkerColumn": "true",
					"pl7.app/label": clusterAxisSpec.annotations["pl7.app/label"] + " Linker",
					"pl7.app/table/visibility": "optional"
				}
			}
		}]
	}, {splitDataAndSpec: true, mem: defaultConvMem, cpu: defaultConvCpu})

	// Prepare with informative label for trace
	resolutionStr := string(resolution)
	traceLabel := "Leiden Clustering (res:" + resolutionStr + ")"
	
	// Make trace
	trace := pSpec.makeTrace(inputSpec,
		{type: "milaboratories.leiden-clustering", id: blockId, importance: 50, label: traceLabel}
		)

	// Build leiden clusters pFrame with trace injection
	leidenOutputPf := pframes.pFrameBuilder()
	for k, v in leidenPf {
		leidenOutputPf.add(k, trace.inject(v.spec), v.data)
	}
	leidenOutputPf = leidenOutputPf.build()

	// Build exports pFrame including linker column
	exportsPf := pframes.pFrameBuilder()
	
	for pf in [leidenPf, leidenLinkerPf] {
		for k, v in pf {
			exportsPf.add(k, trace.inject(v.spec), v.data)
		}
	}
	exportsPf = exportsPf.build()

	return {
		outputs: {
			leidenClusters: pframes.exportFrame(leidenOutputPf)
		},
		exports: {
			pf: exportsPf
		}
	}
})

